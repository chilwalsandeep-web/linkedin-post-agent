# ============ Core ============
# Anthropic (Claude) — research + writing. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Models (defaults are fine). claude-opus-4-8 = higher quality, claude-haiku-4-5 = cheaper.
RESEARCH_MODEL=claude-sonnet-5
WRITER_MODEL=claude-sonnet-5

# Where the web server runs, and the base URL used inside emails.
# For local personal use the default is fine (you open email links on this machine).
# If you deploy, set PUBLIC_BASE_URL to the public https URL.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# ============ Email (Gmail SMTP) ============
# 1. Turn on 2-Step Verification for your Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Put your Gmail and the 16-char app password (spaces ok) below.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who receives the headings/draft emails (defaults to GMAIL_USER).
EMAIL_TO=

# ============ Image generation (OpenAI) ============
# Only used when you choose "with image". https://platform.openai.com/api-keys
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
IMAGE_SIZE=1024x1024

# ============ LinkedIn — Connect via OAuth (recommended) ============
# ONE app you own. Users click "Connect LinkedIn" and approve — no dev setup for them.
# From your LinkedIn app -> Auth tab: Client ID + Primary Client Secret.
# Also add the redirect URI below to Auth -> Authorized redirect URLs.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# ---- Legacy fallback: a single hand-pasted token (optional) ----
# If set, used only when no account is connected via OAuth above.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
